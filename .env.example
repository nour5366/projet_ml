# Copiez ce fichier en .env (jamais versionné) puis adaptez les valeurs.
# Mode MOCK : tout marche sans clé et sans Internet.
INFERENCE_MODE=mock
GROQ_API_KEY=
MODEL_ID=qwen/qwen3.8-27b
# Au-dessous de ce score de confiance, la demande est envoyée en revue humaine.
REVIEW_THRESHOLD=0.60
# Mettre 1 pour simuler un fournisseur en panne (l'API doit alors répondre 503). Sinon 0.
SIMULER_PANNE=0

# Configuration Gemini Vision (Multimédia)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_MAX_RETRIES=4
GEMINI_BACKOFF_DELAYS=1.0, 2.0, 4.0, 8.0
